{
  "name": "@luochbiao/dsh-git-branch-switcher",
  "description": "Git branch switcher chip in the composer tool row of the DeepSeek Harness",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milestone-17/dsh-git-branch-switcher.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "git",
    "branch",
    "composer",
    "plugin"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}

