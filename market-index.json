  "plugins": [
    {
      "name": "@luochbiao/dsh-git-branch-switcher",
      "title": {
        "en": "Git Branch Switcher",
        "zh": "Git 分支切换器"
      },
      "description": {
        "en": "A composer chip that shows the current git branch of the session working directory and switches local or remote-tracking branches from a TRAE-style popup menu, with one-click git fetch, create-branch-and-switch, staged-subset commit & push, branch merge with conflict abort, partial stash & restore, and confirmation before touching a dirty tree.",
        "zh": "在输入框工具行显示当前 git 分支的胶囊按钮，TRAE 风格菜单一键切换本地或远端跟踪分支，支持一键同步远端分支、新建分支并立即切换、勾选改动提交并推送、分支合并（自动推断拉取来源、冲突可放弃）和部分暂存与恢复；工作区不干净时先弹确认。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "LuoBiao (milestone-17)",
      "homepage": "https://github.com/milestone-17/dsh-git-branch-switcher#readme",
